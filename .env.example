# Real GPT-Live access is required; no API key is needed for calendar/email testing.
OPENAI_API_KEY=
LIVE_BACKEND_MODEL=gpt-5.6-terra
# Set MAIL_MODE=resend for real access-link delivery, or local for development capture.
MAIL_MODE=local
RESEND_API_KEY=
RESEND_FROM=
# Required recipient for contact-form notifications when MAIL_MODE=resend.
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Cloud: pooled PostgreSQL URL. Leave empty for local PGlite storage.
DATABASE_URL=
# Required for the authenticated production voice-cleanup cron.
CRON_SECRET=
APP_DATA_DIR=.data
APP_ORIGIN=http://localhost:3000

# Optional server-side Google Calendar integration. Leave blank for local-only booking.
# On Vercel use the complete JSON value in GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CALENDAR_ANNA_WEBER=
GOOGLE_CALENDAR_MAX_HOFFMANN=
GOOGLE_CALENDAR_LARA_FISCHER=

# Public developer profile shown in the contact dialog.
LINKEDIN_PROFILE_URL=
