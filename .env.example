# Real GPT-Live access is required; no API key is needed for calendar/email testing.
OPENAI_API_KEY=
LIVE_BACKEND_MODEL=gpt-5.6-luna
# Set MAIL_MODE=resend for real access-link delivery, or local for development capture.
MAIL_MODE=local
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Local SQLite only. Replace storage with Postgres before deploying to Vercel.
APP_DATA_DIR=.data
APP_ORIGIN=http://localhost:3000

# Server-side Google Calendar configuration (booking integration pending).
GOOGLE_APPLICATION_CREDENTIALS=.data/google-calendar-service-account.json
GOOGLE_CALENDAR_ANNA_WEBER=
GOOGLE_CALENDAR_MAX_HOFFMANN=
GOOGLE_CALENDAR_LARA_FISCHER=

# Public developer profile shown in the contact dialog.
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile/
